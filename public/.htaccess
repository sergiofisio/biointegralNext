RewriteEngine On
DirectoryIndex home2.php home.php index.html

# Página 404 do Next (out/404.html) em vez da página padrão da Hostinger
ErrorDocument 404 /404.html

# HTTPS
RewriteCond %{HTTPS} off
RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [R=301,L]

# www (canonical: https://www.biointegralsaude.com.br)
RewriteCond %{HTTP_HOST} !^www\. [NC]
RewriteRule ^ https://www.biointegralsaude.com.br%{REQUEST_URI} [R=301,L]

# Pasta visível (SFTP ignora .well-known)
RewriteRule ^\.well-known/api-catalog/?$ /agent-well-known/api-catalog.json [L]
RewriteRule ^\.well-known/openid-configuration/?$ /agent-well-known/openid-configuration.json [L]
RewriteRule ^\.well-known/oauth-authorization-server/?$ /ad3/oauth-as.json [L]
RewriteRule ^\.well-known/oauth-protected-resource/?$ /ad2/oauth-prm.json [L]
RewriteRule ^\.well-known/mcp/server-card\.json$ /agent-well-known/mcp/server-card.json [L]
RewriteRule ^\.well-known/agent-skills/index\.json$ /agent-well-known/agent-skills/index.json [L]
RewriteRule ^\.well-known/agent-skills/biointegral-clinic/SKILL\.md$ /agent-well-known/agent-skills/biointegral-clinic/SKILL.md [L]
RewriteRule ^auth\.md$ /agent-root/auth.md [L]
RewriteRule ^llms\.txt$ /agent-root/llms.txt [L]
RewriteRule ^index\.md$ /agent-root/index.md [L]
RewriteRule ^openapi\.json$ /agent-root/openapi.json [L]
RewriteRule ^status\.json$ /agent-root/status.json [L]
RewriteRule ^jwks\.json$ /agent-root/jwks.json [L]
RewriteRule ^mcp\.json$ /agent-root/mcp.json [L]
RewriteRule ^webmcp\.js$ /ad2/webmcp.js [L]
RewriteRule ^agent/register/?$ /ad3/register.php [L]
RewriteRule ^agent/auth/?$ /ad3/register.php [L]
RewriteRule ^agent/identity/?$ /ad3/register.php [L]
RewriteRule ^agent/identity/claim/?$ /ad3/register.php [L]
RewriteRule ^oauth2/token/?$ /ad3/register.php [L]
RewriteRule ^oauth2/revoke/?$ /ad3/register.php [L]

# Markdown for Agents — homepage
RewriteCond %{HTTP_ACCEPT} text/markdown [NC]
RewriteRule ^$ /agent-root/index.md [T=text/markdown,E=MARKDOWN_AGENTS:1,L]
RewriteCond %{HTTP_ACCEPT} text/markdown [NC]
RewriteRule ^index\.html$ /agent-root/index.md [T=text/markdown,E=MARKDOWN_AGENTS:1,L]

# Injeta WebMCP no HTML antigo se o SFTP não sobrescrever index.html
<IfModule mod_substitute.c>
  AddOutputFilterByType SUBSTITUTE text/html
  Substitute "s|</body>|<script src=/ad2/webmcp.js></script></body>|ni"
</IfModule>

# Compressão (texto) — reduz TTFB de HTML/CSS/JS/SVG/JSON
<IfModule mod_brotli.c>
  AddOutputFilterByType BROTLI_COMPRESS text/html text/plain text/xml text/css text/javascript application/javascript application/json application/xml image/svg+xml font/woff2
</IfModule>

<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/plain text/xml text/css text/javascript application/javascript application/json application/xml image/svg+xml font/woff2
</IfModule>

<Files "api-catalog.json">
  ForceType application/linkset+json
</Files>
<Files "oauth-authorization-server">
  ForceType application/json
</Files>
<Files "openid-configuration">
  ForceType application/json
</Files>
<Files "oauth-protected-resource">
  ForceType application/json
</Files>
<Files "auth.md">
  ForceType text/markdown
</Files>

<IfModule mod_headers.c>
  Header always set Link "</.well-known/api-catalog>; rel=api-catalog, </openapi.json>; rel=service-desc, </docs/api/>; rel=service-doc, </llms.txt>; rel=describedby"
  Header always set x-markdown-tokens "350" env=MARKDOWN_AGENTS
  Header always set Content-Type "text/markdown; charset=utf-8" env=MARKDOWN_AGENTS

  <Files "api-catalog.json">
    Header set Content-Type "application/linkset+json"
  </Files>
  <Files "oauth-authorization-server">
    Header set Content-Type "application/json"
  </Files>
  <Files "openid-configuration">
    Header set Content-Type "application/json"
  </Files>
  <Files "oauth-protected-resource">
    Header set Content-Type "application/json"
  </Files>
  <Files "auth.md">
    Header set Content-Type "text/markdown; charset=utf-8"
  </Files>

  # Segurança
  Header always set Strict-Transport-Security "max-age=31536000; includeSubDomains"
  Header always set X-Content-Type-Options "nosniff"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set Permissions-Policy "camera=(), microphone=(), geolocation=()"
  Header always set X-Frame-Options "SAMEORIGIN"
  # Cloudflare Insights (Web Analytics) + Turnstile + EmailJS + Maps
  Header always set Content-Security-Policy "default-src 'self'; base-uri 'self'; form-action 'self'; frame-ancestors 'self'; script-src 'self' 'unsafe-inline' https://challenges.cloudflare.com https://static.cloudflareinsights.com; style-src 'self' 'unsafe-inline'; img-src 'self' data: https:; font-src 'self' data:; connect-src 'self' https://api.emailjs.com https://challenges.cloudflare.com https://cloudflareinsights.com; frame-src https://www.google.com https://maps.google.com https://challenges.cloudflare.com;"

  # HTML e dados dinâmicos — sempre buscar versão nova no servidor
  <FilesMatch "\.(html?|json|xml|txt)$">
    Header set Cache-Control "no-cache, no-store, must-revalidate"
    Header set Pragma "no-cache"
    Header set Expires "0"
  </FilesMatch>

  <FilesMatch "\.(css|js|webp|png|jpg|jpeg|svg|woff2|ico)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
</IfModule>

<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType text/html "access plus 0 seconds"
  ExpiresByType application/json "access plus 0 seconds"
  ExpiresByType text/xml "access plus 0 seconds"
  ExpiresByType text/css "access plus 1 year"
  ExpiresByType application/javascript "access plus 1 year"
  ExpiresByType image/webp "access plus 1 year"
  ExpiresByType image/png "access plus 1 year"
  ExpiresByType image/jpeg "access plus 1 year"
  ExpiresByType image/svg+xml "access plus 1 year"
  ExpiresByType font/woff2 "access plus 1 year"
</IfModule>

# Rotas legadas
RewriteRule ^livros/?$ / [R=301,L]
